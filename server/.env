#server port
PORT=3336
API_URL=""
NODE_ENV=production
LOG_SLOW_QUERIES=true
API_DOC_URL="api-docs"

#Database URL
# Docker PostgreSQL (port 5444)
DATABASE_URL="postgresql://postgres:postgres@localhost:5444/postgres?schema=public"
# For internal Docker container network:
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/postgres?schema=public"

# Redis Configuration (Host port 6380 mapped to container 6379)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0

