# Dependencies
node_modules/
.pnp
.pnp.js

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/

# Logs & temp
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo

# ==============================================================================
# Storage Directories: Ignore all media/generated files, keep only .gitkeep
# ==============================================================================

# Storage root files (e.g. index.json)
storage/*
!storage/.gitkeep
!storage/uploads/
!storage/temp/
!storage/exports/
!storage/others/

# storage/uploads
storage/uploads/*
!storage/uploads/.gitkeep

# storage/temp
storage/temp/*
!storage/temp/.gitkeep

# storage/exports
storage/exports/*
!storage/exports/.gitkeep

# storage/others (680+ source video files ignored)
storage/others/*
!storage/others/.gitkeep
!storage/others/transcript/

# storage/others/transcript (generated individual transcripts and index.json ignored)
storage/others/transcript/*
!storage/others/transcript/.gitkeep
!storage/others/transcript/main/

# storage/others/transcript/main (merged master translations ignored)
storage/others/transcript/main/*
!storage/others/transcript/main/.gitkeep
